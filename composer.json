{
    "name": "gubee-marketplace/module-gubee-integration",
    "description": "Gubee Integration Module for Magento 2",
    "license": "proprietary",
    "type": "magento2-module",
    "require": {
        "php": "^8.1",
        "gubee-marketplace/php-sdk": "@dev",
        "magento/framework": "^103"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.43.0",
        "ergebnis/composer-normalize": "^2.52",
        "ergebnis/license": "^2.7",
        "friendsofphp/php-cs-fixer": "^3.75",
        "laravel/sail": "^1.66",
        "magento/magento-coding-standard": "^40.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-browser": "^4.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "repositories": {
        "magento": {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        },
        "gubee-sdk": {
            "type": "vcs",
            "url": "git@github.com:maco-studios/gubee-php-sdk.git"
        }
    },
    "autoload": {
        "psr-4": {
            "Gubee\\Integration\\": "src/"
        },
        "files": [
            "src/registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "mage-os/composer-dependency-version-audit-plugin": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "lint": [
            "@phpcs",
            "@phpstan",
            "@normalize-check"
        ],
        "normalize-check": "composer normalize --dry-run --diff",
        "phpcbf": "phpcbf",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse",
        "test": "pest"
    }
}
