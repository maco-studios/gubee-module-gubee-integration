APP_NAME="Gubee Module"
BCRYPT_ROUNDS=12
# Logging
# LOG_CHANNEL=stack fans out to the channels listed in LOG_STACK.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
# Primary relational connection for Eloquent/migrations. When DB_CONNECTION
# is sqlite the host/port/credentials below are unused. Uncomment them for
# mysql/mariadb/pgsql, matching the "mysql" service in compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magento
DB_USERNAME=magento
DB_PASSWORD=magento

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
# MAIL_MAILER=log writes mail to the log instead of sending it.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# RabbitMQ
# Credentials for the "rabbitmq" service in compose.yml.
RABBITMQ_USER=magento
RABBITMQ_PASSWORD=magento
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=magento
