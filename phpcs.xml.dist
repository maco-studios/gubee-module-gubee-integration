<?xml version="1.0"?>
<ruleset name="Gubee_Integration">
    <description>Coding standard for the Gubee Integration Magento 2 module.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php,phtml"/>
    <arg value="sp"/>

    <rule ref="Magento2"/>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/generated/*</exclude-pattern>
</ruleset>
